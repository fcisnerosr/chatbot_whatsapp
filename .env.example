# Configuración de Gupshup (Obligatorio)
GUPSHUP_API_KEY=tu_api_key_aqui
GUPSHUP_SOURCE=tu_numero_origen_gupshup  # Ejemplo: 5215512345678

# Configuración de la Aplicación (Opcional - Valores por defecto mostrados)
GUPSHUP_APP_NAME=RolesClubBot
VERIFY_TOKEN=rolesclub-verify
PORT=5000
LOG_LEVEL=INFO

# Rutas de Datos (Opcional)
CLUBS_DIR=data/clubs
SESSION_DB_PATH=data/sessions.sqlite3
